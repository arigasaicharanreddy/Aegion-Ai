# ==============================================================================
# AEGION AI — ENVIRONMENT CONFIGURATION (NODE GATEWAY + VITE FRONTEND)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE AI & ORIGIN CONFIGURATION
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Server-side only (never expose to React or client bundles).
GEMINI_API_KEY=""

# APP_URL: Hosted origin URL (used for activation, password reset, and verification links).
APP_URL="http://localhost:3000"

# VITE_AEGION_API_URL: Optional frontend override when API gateway runs on a separate host.
VITE_AEGION_API_URL=""

# ------------------------------------------------------------------------------
# 2. SUPER ADMIN & SESSION SECURITY (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Sole Super Admin identity provisioned on server boot when not yet configured.
AEGION_SUPER_ADMIN_EMAIL="aegionlabs.in@gmail.com"

# Initial Super Admin passphrase stored only in server secrets / .env (never in source code).
AEGION_SUPER_ADMIN_INITIAL_PASSWORD=""

# Set to "true" temporarily to re-provision the initial Super Admin password on startup.
AEGION_SUPER_ADMIN_FORCE_RESET="false"

# AEGION_SESSION_SECRET: Cryptographic secret for signing session cookies in production.
AEGION_SESSION_SECRET=""

# ------------------------------------------------------------------------------
# 3. OPTIONAL STANDALONE PYTHON ENGINE
# ------------------------------------------------------------------------------
# AEGION_PYTHON_API_URL: URL of your separately deployed Python FastAPI + LangGraph backend.
AEGION_PYTHON_API_URL=""

# ------------------------------------------------------------------------------
# 4. EMAIL & WHATSAPP AUTOMATION
# ------------------------------------------------------------------------------
# Configure Gmail API (OAuth), SMTP, Resend, or SendGrid for transactional emails.
AEGION_SENDER_EMAIL="aegionlabs.in@gmail.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# WhatsApp Business Cloud API (Optional)
WHATSAPP_WABA_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
AEGION_ADMIN_WHATSAPP_NUMBER=""

# Optional pre-existing Google Spreadsheet IDs
AEGION_SHEETS_SPREADSHEET_ID=""
AEGION_CONTACT_SHEETS_SPREADSHEET_ID=""
