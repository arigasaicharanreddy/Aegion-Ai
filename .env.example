# ==============================================================================
# AEGION AI — ENVIRONMENT CONFIGURATION (NODE GATEWAY + VITE FRONTEND)
# ==============================================================================
# Zero secrets or paid services are required for Free Development Mode.
# The frontend preview and Express API gateway run cleanly with defaults.

# ------------------------------------------------------------------------------
# 1. OPTIONAL IN FREE DEV MODE (Automatically injected in Google AI Studio)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Used strictly on the server side (/api/v1/chat/stream).
# If omitted in Free Dev Mode, the builder falls back to deterministic mock SSE generation.
GEMINI_API_KEY=""

# AEGION_FREE_DEV_MODE: Set to "false" to disable dev preview shortcuts even outside production.
AEGION_FREE_DEV_MODE="true"

# APP_URL: Hosted origin URL (used for activation links and cookie SameSite attributes).
APP_URL="http://localhost:3000"

# VITE_AEGION_API_URL: Optional frontend override when API gateway runs on a separate host.
VITE_AEGION_API_URL=""

# ------------------------------------------------------------------------------
# 2. OPTIONAL / SEPARATELY DEPLOYED PYTHON ENGINE
# ------------------------------------------------------------------------------
# AEGION_PYTHON_API_URL: URL of your separately deployed Python FastAPI + LangGraph backend.
# If unset, the Express gateway and frontend mock API handle all features without blocking.
AEGION_PYTHON_API_URL=""

# ------------------------------------------------------------------------------
# 3. PRODUCTION-ONLY SECURITY & SUPER ADMIN BOOTSTRAP
# ------------------------------------------------------------------------------
# AEGION_SUPER_ADMIN_INITIAL_PASSWORD: Initial bootstrap password for arigasaicharan@gmail.com.
# Never hardcode in source code. If omitted, a one-time random passphrase is generated at startup.
AEGION_SUPER_ADMIN_INITIAL_PASSWORD=""

# AEGION_SESSION_SECRET: Cryptographic secret for signing session cookies in production.
AEGION_SESSION_SECRET=""

# ------------------------------------------------------------------------------
# 4. PRODUCTION-ONLY EMAIL & WHATSAPP AUTOMATION (Optional during development)
# ------------------------------------------------------------------------------
# Email notifications are automatically skipped (logged non-blockingly) during development.
AEGION_SENDER_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# WhatsApp Business Cloud API (Optional)
WHATSAPP_WABA_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
AEGION_ADMIN_WHATSAPP_NUMBER=""

# Optional target Google Sheet ID for AEGION_AI_CUSTOMER_REGISTRATIONS
AEGION_SHEETS_SPREADSHEET_ID=""
